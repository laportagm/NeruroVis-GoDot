# Godot-specific ignores
.godot/
export.cfg
export_presets.cfg
*.tmp
*.uid

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# Build directories
build/
dist/
export/
exports/

# Log files
*.log
logs/
test_logs/
test_reports/

# Temporary files
tmp/
temp/
.tmp/

# Backup files
*.backup
*.bak
backup/

# Python
__pycache__/
*.py[cod]
*$py.class

# Environment files
.env
.env.local
.env.*.local

# AI session logs
ai/sessions/

# Archive (but track structure)
archive/*
\!archive/legacy_docs/
archive/legacy_docs/*
\!archive/legacy_docs/.gitkeep
EOF < /dev/null