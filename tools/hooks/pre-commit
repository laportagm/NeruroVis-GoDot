#!/bin/bash

# NeuroVis Pre-Commit Hook
# Validates architecture compliance before allowing commits

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "Running pre-commit checks..."

# Get the repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Check 1: Architecture Validation
echo -n "Validating architecture... "
if [ -x "./tools/scripts/quick_validation.sh" ]; then
    if ./tools/scripts/quick_validation.sh > /dev/null 2>&1; then
        echo -e "${GREEN}✓${NC}"
    else
        echo -e "${RED}✗${NC}"
        echo "Architecture validation failed! Run ./tools/scripts/quick_validation.sh for details."
        exit 1
    fi
else
    echo -e "${YELLOW}⚠${NC} (validation script not found)"
fi

# Check 2: No .uid files
echo -n "Checking for .uid files... "
uid_files=$(git diff --cached --name-only | grep '\.uid$' || true)
if [ -z "$uid_files" ]; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗${NC}"
    echo "Error: .uid files should not be committed:"
    echo "$uid_files"
    echo "Add *.uid to .gitignore"
    exit 1
fi

# Check 3: No temporary files
echo -n "Checking for temporary files... "
temp_files=$(git diff --cached --name-only | grep -E '\.(tmp|bak|backup)$' || true)
if [ -z "$temp_files" ]; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗${NC}"
    echo "Error: Temporary files should not be committed:"
    echo "$temp_files"
    exit 1
fi

# Check 4: Documentation in correct location
echo -n "Checking documentation placement... "
wrong_docs=$(git diff --cached --name-only | grep -E '^src/.*\.md$' || true)
if [ -z "$wrong_docs" ]; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗${NC}"
    echo "Error: Documentation files should not be in src/:"
    echo "$wrong_docs"
    echo "Move .md files to docs/ or ai/context/"
    exit 1
fi

# Check 5: Source files in correct location
echo -n "Checking source file placement... "
wrong_source=$(git diff --cached --name-only | grep -E '^(docs|assets|ai)/.*\.(gd|tscn)$' || true)
if [ -z "$wrong_source" ]; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${RED}✗${NC}"
    echo "Error: Source files should be in src/:"
    echo "$wrong_source"
    exit 1
fi

# Check 6: Root directory cleanliness
echo -n "Checking root directory... "
new_root_files=$(git diff --cached --name-only | grep -E '^[^/]+\.(gd|tscn|md)$' | grep -v -E '^(README|LICENSE|LICENSES)\.md$' || true)
if [ -z "$new_root_files" ]; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${YELLOW}⚠${NC}"
    echo "Warning: New files in root directory:"
    echo "$new_root_files"
    echo "Consider moving these to appropriate directories"
fi

# Check 7: File naming conventions
echo -n "Checking naming conventions... "
bad_names=$(git diff --cached --name-only | grep -E '\.(gd|tscn)$' | grep -E '[ -]' || true)
if [ -z "$bad_names" ]; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${YELLOW}⚠${NC}"
    echo "Warning: Files with spaces or hyphens in names:"
    echo "$bad_names"
    echo "Consider using PascalCase or snake_case"
fi

echo -e "${GREEN}All pre-commit checks passed!${NC}"